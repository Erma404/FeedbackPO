# Clé Anthropic, côté serveur uniquement.
# NE JAMAIS préfixer par VITE_ : une variable VITE_ est incorporée au code envoyé au navigateur.
# En local : copie ce fichier en .env et renseigne ta clé.
# En production : à définir dans Vercel (Settings > Environment Variables).
ANTHROPIC_API_KEY=

# Limites d'usage (facultatif, valeurs par défaut entre parenthèses)
# LIMIT_IP_HOUR=25
# LIMIT_IP_DAY=50
# LIMIT_GLOBAL_DAY=400

# Compteurs : ajoutés automatiquement par l'intégration Upstash Redis de Vercel.
# En local, le proxy de dev n'applique pas de quotas.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
